{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npx vitest*)",
      "Bash(npm run test)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npm run scrape)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx oxlint*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Write(src/**)",
      "Write(scripts/**)",
      "Write(docs/**)",
      "Write(public/**)",
      "Edit(src/**)",
      "Edit(scripts/**)",
      "Edit(docs/**)",
      "Edit(public/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production*)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.production*)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production*)",
      "Write(src/data/**)",
      "Edit(src/data/**)",
      "Write(public/icons/**)",
      "Edit(public/icons/**)",
      "Bash(curl *)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(npm run deploy)",
      "Bash(npm install *)",
      "Bash(npm uninstall*)",
      "Bash(npx shadcn*)",
      "Write(.env.example)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node_modules/.bin/oxlint --fix \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true
  }
}
